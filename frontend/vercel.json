{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://<REPLACE_WITH_YOUR_BACKEND_URL>/api/$1"
    },
    {
      "source": "/docs",
      "destination": "https://<REPLACE_WITH_YOUR_BACKEND_URL>/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://<REPLACE_WITH_YOUR_BACKEND_URL>/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
